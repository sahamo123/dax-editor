{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["ffmpeg", "ffprobe"],
  "workspaces": {
    "apps/desktop": {
      "entry": ["e2e/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,mts,mjs}"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/evals": {
      "entry": ["src/cli.ts", "src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/protocol": {
      "project": ["src/**/*.ts"]
    }
  }
}
