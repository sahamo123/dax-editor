{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["ffmpeg", "ffprobe", "espeak-ng", "pgrep"],
  "workspaces": {
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/evals": {
      "entry": ["src/cli.ts", "src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/protocol": {
      "project": ["src/**/*.ts"]
    },
    "packages/stt": {
      "project": ["src/**/*.ts"]
    }
  }
}
