{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["ffmpeg", "ffprobe", "rustc", "espeak-ng", "pgrep", "explorer.exe"],
  "workspaces": {
    "apps/desktop": {
      "entry": ["e2e/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,mts,mjs}"]
    },
    "packages/agent": {
      "project": ["src/**/*.ts"]
    },
    "packages/bridges": {
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/engine": {
      "project": ["src/**/*.ts"]
    },
    "packages/evals": {
      "entry": ["src/cli.ts", "src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/local-llm": {
      "entry": [
        "src/scripts/*.ts",
        "src/test-helpers/orphan-parent.mjs",
        "src/test-helpers/fake-llama-server.mjs"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/mcp": {
      "entry": ["src/editor-proxy.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/protocol": {
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "project": ["src/**/*.ts"]
    },
    "packages/stt": {
      "project": ["src/**/*.ts"]
    }
  }
}
