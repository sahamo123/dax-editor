{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["ffmpeg", "ffprobe", "rustc"],
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "scripts/*.test.mjs",
        "shell-placeholder/dax-server-standin.mjs",
        "shell-placeholder/web/app.js"
      ],
      "project": ["scripts/**/*.mjs", "shell-placeholder/**/*.{js,mjs}"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/evals": {
      "entry": ["src/cli.ts", "src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/protocol": {
      "project": ["src/**/*.ts"]
    }
  }
}
