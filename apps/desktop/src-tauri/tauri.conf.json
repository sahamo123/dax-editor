{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dax Editor",
  "version": "../package.json",
  "identifier": "org.daxeditor.desktop",
  "mainBinaryName": "dax-editor",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev --host 127.0.0.1",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Dax Editor",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*",
        "img-src": "'self' data: blob: http://127.0.0.1:* http://localhost:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "useLocalToolsDir": true,
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"],
    "category": "Video",
    "shortDescription": "Free, open-source, prompt-driven video editor",
    "longDescription": "Dax Editor is a free, open-source video editor. Describe an edit in chat and the video changes, or edit by hand on the timeline. Works with or without AI.",
    "copyright": "Copyright 2026 dax-editor contributors. Apache-2.0.",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/dax-node", "binaries/dax-ffmpeg", "binaries/dax-ffprobe"],
    "resources": {
      "resources/server/": "server/",
      "resources/assets/": "assets/",
      "resources/skills/": "skills/",
      "resources/templates/": "templates/",
      "resources/local-ai/": "local-ai/",
      "resources/licenses/": "licenses/"
    },
    "linux": {
      "deb": {
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "section": "video"
      },
      "rpm": {
        "recommends": ["gstreamer1-plugins-good", "gstreamer1-plugins-bad-free"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib"
      },
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true }
    }
  }
}
