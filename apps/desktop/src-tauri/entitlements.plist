<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS hardened-runtime entitlements, applied to the app and to every sidecar Tauri signs.
     The bundled Node.js runs V8, which needs JIT memory; without these two keys a notarized
     build crashes at startup. Nothing else is requested (no camera, mic, network-server, etc.). -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
