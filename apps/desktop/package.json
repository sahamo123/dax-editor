{
  "name": "@dax/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "The dax-editor desktop UI: chat on the left, preview and timeline on the right. Runs in a browser (dev, tests) and inside the Tauri shell.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build:engine && playwright test",
    "mock-server": "node e2e/mock-server.mjs",
    "docs:check": "typedoc",
    "build:engine": "pnpm --filter \"@dax/engine...\" build",
    "editor:dev": "vite --config vite.editor.config.ts",
    "editor:mock": "node src/editor/dev/mock-server.ts",
    "editor:typecheck": "tsc -p tsconfig.editor.json --noEmit",
    "editor:test": "vitest run --config vitest.editor.config.ts",
    "editor:e2e": "playwright test --config playwright.editor.config.ts",
    "tauri": "tauri",
    "sidecars:dev": "node scripts/prepare-sidecars.mjs --dev",
    "sidecars:release": "node scripts/prepare-sidecars.mjs --release",
    "shell:dev": "node scripts/prepare-sidecars.mjs --dev && tauri dev",
    "shell:build": "node scripts/prepare-sidecars.mjs --release && tauri build",
    "shell:test": "node --test \"scripts/*.test.mjs\" && cargo test --manifest-path src-tauri/Cargo.toml",
    "shell:lint": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@dax/protocol": "workspace:*",
    "@tauri-apps/api": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@dax/core": "workspace:*",
    "@dax/engine": "workspace:*",
    "@dax/server": "workspace:*",
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "0.28.2",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
