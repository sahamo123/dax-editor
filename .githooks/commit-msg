#!/usr/bin/env bash
# Enforce Conventional Commits on the first line: type(scope)?: subject
# See docs/engineering/git-workflow.md.
set -euo pipefail

first_line="$(head -n1 "$1")"

# Allow merge, revert and fixup commits that git generates itself.
case "$first_line" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "Commit message must follow Conventional Commits, e.g.:" >&2
  echo "  feat(core): add keepRanges" >&2
  echo "  fix(render): handle clips without audio" >&2
  echo "Got: $first_line" >&2
  exit 1
fi
