{
  "name": "dax-editor",
  "private": true,
  "version": "0.0.1",
  "description": "Open-source, prompt-driven video editor. Chat on the left, your video on the right.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r typecheck",
    "dev:desktop": "pnpm --filter @dax/desktop tauri dev"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
