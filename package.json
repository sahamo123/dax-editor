{
  "name": "dax-editor",
  "private": true,
  "version": "0.0.1",
  "description": "Open-source, prompt-driven video editor. Chat on the left, your video on the right.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test && pnpm test:scripts",
    "typecheck": "pnpm build",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "docs:check": "pnpm -r --filter \"./packages/*\" docs:check",
    "deadcode": "knip",
    "check:fast": "pnpm lint && pnpm typecheck",
    "check": "pnpm lint && pnpm build && pnpm docs:check && pnpm docs:okf && pnpm deadcode && pnpm test",
    "dev:desktop": "pnpm --filter @dax/desktop shell:dev",
    "build:desktop": "pnpm --filter @dax/desktop shell:build",
    "eval": "pnpm --filter @dax/evals eval",
    "bootstrap": "bash scripts/bootstrap.sh",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "docs:okf": "node scripts/okf.mjs check docs && node scripts/okf.mjs index docs --check",
    "docs:index": "node scripts/okf.mjs index docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "knip": "^6.42.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "yaml": "^2.9.1"
  }
}
