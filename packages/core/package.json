{
  "name": "@dax/core",
  "version": "0.0.1",
  "description": "Timeline model, edit operations and FFmpeg wrappers shared by the CLI, MCP server and desktop app.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
