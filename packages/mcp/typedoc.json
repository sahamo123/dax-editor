{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.json",
  "emit": "none",
  "treatWarningsAsErrors": true,
  "externalSymbolLinkMappings": {
    "@dax/core": {
      "runCommand": "https://github.com/sahamo123/dax-editor/blob/main/packages/core/src/commands.ts"
    }
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Function",
    "Class",
    "Interface",
    "TypeAlias",
    "Variable",
    "Method",
    "Accessor"
  ]
}
