{
  "id": "local-service-before-after",
  "version": 1,
  "kind": "industry",
  "name": "Local service before and after",
  "description": "Plumber, salon, HVAC and similar: business lower-third and a call-us end card with phone and licence number, pauses trimmed. BEFORE/AFTER labels, time-lapse and captions are listed as not available yet.",
  "tags": ["local-business", "service", "before-after", "reels", "tiktok", "shorts"],
  "license": "Apache-2.0",
  "author": "dax-editor contributors",
  "source": "docs/research/industry-video-templates.md section 7 and example B",
  "variables": [
    {
      "name": "business_name",
      "label": "Business name",
      "type": "name",
      "required": true,
      "maxLength": 50,
      "example": "Bright Plumbing"
    },
    {
      "name": "service_area",
      "label": "Service area",
      "type": "text",
      "required": false,
      "maxLength": 50,
      "example": "Springfield and nearby"
    },
    {
      "name": "cta_text",
      "label": "Call to action",
      "type": "text",
      "required": false,
      "maxLength": 30,
      "default": "Call for a free quote",
      "example": "Call for a free quote"
    },
    {
      "name": "phone",
      "label": "Phone number",
      "type": "phone",
      "required": true,
      "example": "+1 555 010 0199"
    },
    {
      "name": "licence_no",
      "label": "Licence number (if required where you work)",
      "type": "text",
      "required": false,
      "maxLength": 30,
      "example": "Lic. 123456"
    }
  ],
  "formats": [
    {
      "aspect": "9:16",
      "lengthSec": {
        "min": 15,
        "max": 45
      },
      "platforms": [
        {
          "platform": "instagram-reels"
        },
        {
          "platform": "tiktok"
        },
        {
          "platform": "youtube-shorts",
          "lengthSec": {
            "min": 15,
            "max": 60
          }
        }
      ]
    },
    {
      "aspect": "16:9",
      "lengthSec": {
        "min": 30,
        "max": 60
      },
      "platforms": [
        {
          "platform": "website",
          "lengthSec": {
            "min": 30,
            "max": 60
          }
        }
      ]
    }
  ],
  "defaultAspect": "9:16",
  "cleanup": {
    "preset": "standard"
  },
  "beats": [
    {
      "id": "problem",
      "name": "Problem on camera",
      "durationSec": {
        "min": 0,
        "max": 5
      },
      "guidance": "Show the problem straight away.",
      "overlay": "business"
    },
    {
      "id": "before",
      "name": "Before",
      "durationSec": {
        "min": 3,
        "max": 6
      },
      "guidance": "Same spot and angle as the after.",
      "footage": "Before shot."
    },
    {
      "id": "work",
      "name": "The work",
      "durationSec": {
        "min": 10,
        "max": 20
      },
      "guidance": "Keep work sounds; time-lapse is fine.",
      "footage": "Repair or install."
    },
    {
      "id": "after",
      "name": "After",
      "durationSec": {
        "min": 3,
        "max": 6
      },
      "guidance": "Same spot, same angle.",
      "footage": "After shot."
    },
    {
      "id": "quote",
      "name": "Customer quote",
      "durationSec": {
        "min": 5,
        "max": 10
      },
      "guidance": "Optional, with a release.",
      "footage": "Customer on camera."
    },
    {
      "id": "cta",
      "name": "Call to action",
      "durationSec": {
        "min": 4,
        "max": 5
      },
      "guidance": "Say the phone number and show it as text.",
      "overlay": "end-card"
    }
  ],
  "overlays": [
    {
      "id": "business",
      "preset": "lower-third-slide",
      "text": "{{business_name}}",
      "subtitle": "{{service_area}}",
      "when": "business_name",
      "anchor": "start",
      "offset": 0.5,
      "duration": 4,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 1
    },
    {
      "id": "end-card",
      "preset": "title-fade",
      "text": "{{cta_text}}",
      "subtitle": "{{phone}} · {{licence_no}}",
      "anchor": "end",
      "offset": 0,
      "duration": 4.5,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 2
    }
  ],
  "fades": {
    "out": 0.3
  },
  "deferred": [
    {
      "id": "labels",
      "title": "BEFORE and AFTER labels",
      "description": "Labels shown over the before and after shots.",
      "requires": ["beat-matching"]
    },
    {
      "id": "timelapse",
      "title": "Time-lapse of the work",
      "description": "Speed up the repair footage.",
      "requires": ["speed-change"]
    },
    {
      "id": "captions",
      "title": "Captions",
      "description": "Captions that repeat the phone number.",
      "requires": ["captions"]
    },
    {
      "id": "music",
      "title": "Light music",
      "description": "None, or a light bed ducked under speech.",
      "requires": ["music-bed", "audio-ducking"]
    }
  ],
  "notes": [
    {
      "category": "advertising",
      "text": "Show a licence number only if it is real; rules for trades and salons differ by state and country."
    },
    {
      "category": "testimonials",
      "text": "Testimonials and reviews must come from real people who agreed to appear and reflect their real experience. If you paid them or gave them something free, say so in the video itself, not only in the caption."
    },
    {
      "category": "privacy",
      "text": "Get consent from every identifiable person in the footage, and blur or crop anyone who has not agreed. Minors need a parent or guardian's consent."
    },
    {
      "category": "music",
      "text": "Use only music you have the right to use: a licensed or CC0 library, or your own. Do not reuse a platform's in-app sound library on other platforms, and check that the licence covers paid ads if you promote the video."
    }
  ],
  "confirmations": [
    {
      "id": "licence",
      "ask": "Is the licence number correct, and is one required where you work?"
    },
    {
      "id": "same-spot",
      "ask": "Are before and after the same spot and angle, with only the work changed?"
    },
    {
      "id": "release",
      "ask": "Do you have a release from every customer or person visible?"
    }
  ]
}
