{
  "id": "ecommerce-product-ad",
  "version": 1,
  "kind": "industry",
  "name": "Product ad",
  "description": "Vertical product ad: hook in the first seconds, product name, offer callout and a shop-now end card, with pauses trimmed tight. Punch-ins on alternate shots and music (when you supply it) are added. Captions and B-roll cutaways are listed as not available yet.",
  "tags": ["ecommerce", "ad", "product", "tiktok", "meta", "shorts"],
  "license": "Apache-2.0",
  "author": "dax-editor contributors",
  "source": "docs/research/industry-video-templates.md section 6",
  "variables": [
    {
      "name": "title",
      "label": "Hook",
      "type": "text",
      "required": false,
      "maxLength": 60,
      "example": "This fixed my morning routine"
    },
    {
      "name": "product_name",
      "label": "Product name",
      "type": "text",
      "required": false,
      "maxLength": 40,
      "example": "ThermoFlask 2"
    },
    {
      "name": "offer",
      "label": "Offer",
      "type": "text",
      "required": false,
      "maxLength": 40,
      "example": "20% off today"
    },
    {
      "name": "cta_text",
      "label": "Call to action",
      "type": "text",
      "required": false,
      "maxLength": 30,
      "default": "Shop now",
      "example": "Shop now"
    },
    {
      "name": "url",
      "label": "Web address",
      "type": "url",
      "required": false,
      "example": "example.com/book"
    }
  ],
  "formats": [
    {
      "aspect": "9:16",
      "lengthSec": {
        "min": 15,
        "max": 34
      },
      "platforms": [
        {
          "platform": "tiktok"
        },
        {
          "platform": "instagram-reels"
        },
        {
          "platform": "youtube-shorts",
          "lengthSec": {
            "min": 10,
            "max": 30
          },
          "note": "Action ads run 10 to 30 seconds"
        }
      ]
    },
    {
      "aspect": "4:5",
      "lengthSec": {
        "min": 15,
        "max": 30
      },
      "platforms": [
        {
          "platform": "facebook-feed"
        },
        {
          "platform": "instagram-feed"
        }
      ]
    }
  ],
  "defaultAspect": "9:16",
  "cleanup": {
    "preset": "tight"
  },
  "beats": [
    {
      "id": "hook",
      "name": "Hook",
      "durationSec": {
        "min": 0,
        "max": 3
      },
      "guidance": "Product in the first frame.",
      "overlay": "hook"
    },
    {
      "id": "problem",
      "name": "Problem",
      "durationSec": {
        "min": 3,
        "max": 6
      },
      "guidance": "The problem the product removes."
    },
    {
      "id": "demo",
      "name": "Demo",
      "durationSec": {
        "min": 6,
        "max": 18
      },
      "guidance": "Show it working; change the picture every 1 to 2 seconds."
    },
    {
      "id": "proof",
      "name": "Proof",
      "durationSec": {
        "min": 3,
        "max": 5
      },
      "guidance": "A real review or real use."
    },
    {
      "id": "offer",
      "name": "Offer and call to action",
      "durationSec": {
        "min": 3,
        "max": 5
      },
      "guidance": "State the offer and one action.",
      "overlay": "offer"
    }
  ],
  "overlays": [
    {
      "id": "hook",
      "preset": "title-pop",
      "text": "{{title}}",
      "when": "title",
      "anchor": "start",
      "offset": 0.2,
      "duration": 2,
      "minDuration": 1,
      "maxFraction": 0.45,
      "priority": 1
    },
    {
      "id": "speaker",
      "preset": "lower-third-slide",
      "text": "{{product_name}}",
      "subtitle": "",
      "when": "product_name",
      "anchor": "start",
      "offset": 3,
      "duration": 3,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 1
    },
    {
      "id": "offer",
      "preset": "callout-slide-up",
      "text": "{{offer}}",
      "when": "offer",
      "anchor": "end",
      "offset": 0,
      "duration": 3.5,
      "minDuration": 1.5,
      "maxFraction": 0.4,
      "priority": 1
    },
    {
      "id": "end-card",
      "preset": "title-fade",
      "text": "{{cta_text}}",
      "subtitle": "{{url}}",
      "anchor": "end",
      "offset": 0,
      "duration": 3.5,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 2
    }
  ],
  "fades": {
    "out": 0.3
  },
  "effects": [
    {
      "id": "music",
      "kind": "music",
      "title": "Upbeat music",
      "description": "Upbeat music, lowered while someone speaks.",
      "level": 0.25
    },
    {
      "id": "punch-ins",
      "kind": "zoom",
      "title": "Punch-ins in the demo",
      "description": "A 20 percent punch-in on every second shot to keep a new picture coming.",
      "mode": "alternate-cuts",
      "scale": 1.2,
      "every": 2,
      "minShotSec": 1
    }
  ],
  "deferred": [
    {
      "id": "captions",
      "title": "Captions",
      "description": "On-screen text at no more than 5 to 10 words per second.",
      "requires": ["captions"]
    },
    {
      "id": "demo-cuts",
      "title": "Cutaways in the demo",
      "description": "A new picture every 1 to 2 seconds: cutaways of the product in use.",
      "requires": ["broll"]
    }
  ],
  "notes": [
    {
      "category": "testimonials",
      "text": "Testimonials and reviews must come from real people who agreed to appear and reflect their real experience. If you paid them or gave them something free, say so in the video itself, not only in the caption."
    },
    {
      "category": "advertising",
      "text": "If a company paid you, gave you the product free, or you have any other connection to it, say so clearly in the video, not only in the caption or description."
    },
    {
      "category": "advertising",
      "text": "'Limited time' and price claims must be true on the day the ad runs. Show the real price, and shipping costs where they apply."
    },
    {
      "category": "music",
      "text": "Use only music you have the right to use: a licensed or CC0 library, or your own. Do not reuse a platform's in-app sound library on other platforms, and check that the licence covers paid ads if you promote the video."
    }
  ],
  "confirmations": [
    {
      "id": "offer-true",
      "ask": "Is the offer or 'limited time' claim true on the day you publish?"
    },
    {
      "id": "reviews-real",
      "ask": "Are all reviews or reactions shown real and from real customers?"
    }
  ]
}
