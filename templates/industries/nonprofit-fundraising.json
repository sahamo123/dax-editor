{
  "id": "nonprofit-fundraising",
  "version": 1,
  "kind": "industry",
  "name": "Non-profit appeal",
  "description": "Person-first appeal: pauses kept for emotional moments, a name lower-third, an impact callout and a donate end card. Captions and music are listed as not available yet.",
  "tags": ["nonprofit", "fundraising", "charity", "appeal", "youtube", "reels"],
  "license": "Apache-2.0",
  "author": "dax-editor contributors",
  "source": "docs/research/industry-video-templates.md section 15",
  "variables": [
    {
      "name": "speaker_name",
      "label": "Person's name",
      "type": "name",
      "required": false,
      "maxLength": 50,
      "example": "Alex Rivera"
    },
    {
      "name": "speaker_role",
      "label": "Who they are",
      "type": "text",
      "required": false,
      "maxLength": 70,
      "example": "Volunteer since 2022"
    },
    {
      "name": "impact",
      "label": "What a gift does",
      "type": "text",
      "required": false,
      "maxLength": 50,
      "example": "$25 feeds a family for a week"
    },
    {
      "name": "cta_text",
      "label": "Call to action",
      "type": "text",
      "required": false,
      "maxLength": 30,
      "default": "Donate today",
      "example": "Donate today"
    },
    {
      "name": "url",
      "label": "Web address",
      "type": "url",
      "required": false,
      "example": "example.org/give"
    }
  ],
  "formats": [
    {
      "aspect": "16:9",
      "lengthSec": {
        "min": 60,
        "max": 120
      },
      "platforms": [
        {
          "platform": "website",
          "lengthSec": {
            "min": 60,
            "max": 90
          }
        },
        {
          "platform": "youtube",
          "lengthSec": {
            "min": 60,
            "max": 180
          }
        }
      ]
    },
    {
      "aspect": "9:16",
      "lengthSec": {
        "min": 15,
        "max": 45
      },
      "platforms": [
        {
          "platform": "instagram-reels"
        },
        {
          "platform": "tiktok"
        },
        {
          "platform": "youtube-shorts"
        }
      ]
    }
  ],
  "defaultAspect": "16:9",
  "cleanup": {
    "preset": "gentle"
  },
  "beats": [
    {
      "id": "person",
      "name": "Person-first hook",
      "durationSec": {
        "min": 0,
        "max": 5
      },
      "guidance": "Start with a person, not a statistic.",
      "overlay": "speaker"
    },
    {
      "id": "problem",
      "name": "The problem",
      "durationSec": {
        "min": 5,
        "max": 15
      },
      "guidance": "Plain and specific."
    },
    {
      "id": "people",
      "name": "The people affected",
      "durationSec": {
        "min": 15,
        "max": 30
      },
      "guidance": "Let moments breathe for 2 to 4 seconds; no fast cuts on testimony."
    },
    {
      "id": "work",
      "name": "What you do",
      "durationSec": {
        "min": 10,
        "max": 15
      },
      "guidance": "What the organisation does about it."
    },
    {
      "id": "ask",
      "name": "The ask",
      "durationSec": {
        "min": 5,
        "max": 10
      },
      "guidance": "Make the gift's impact concrete, before 60 seconds.",
      "overlay": "impact"
    },
    {
      "id": "url",
      "name": "Donate card",
      "durationSec": {
        "min": 5,
        "max": 5
      },
      "guidance": "Show the address.",
      "overlay": "end-card"
    }
  ],
  "overlays": [
    {
      "id": "speaker",
      "preset": "lower-third-slide",
      "text": "{{speaker_name}}",
      "subtitle": "{{speaker_role}}",
      "when": "speaker_name",
      "anchor": "start",
      "offset": 1.5,
      "duration": 4,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 1
    },
    {
      "id": "impact",
      "preset": "callout-slide-up",
      "text": "{{impact}}",
      "when": "impact",
      "anchor": "end",
      "offset": 6,
      "duration": 4,
      "minDuration": 1.5,
      "maxFraction": 0.4,
      "priority": 1
    },
    {
      "id": "end-card",
      "preset": "title-fade",
      "text": "{{cta_text}}",
      "subtitle": "{{url}}",
      "anchor": "end",
      "offset": 0,
      "duration": 5,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 2
    }
  ],
  "fades": {
    "in": 1,
    "out": 1.5
  },
  "deferred": [
    {
      "id": "captions",
      "title": "Captions",
      "description": "Captions for people who watch muted.",
      "requires": ["captions"]
    },
    {
      "id": "music",
      "title": "Warm sparse music",
      "description": "Soft music, never a crisis sting.",
      "requires": ["music-bed", "audio-ducking"]
    }
  ],
  "notes": [
    {
      "category": "privacy",
      "text": "Get consent from every identifiable person in the footage, and blur or crop anyone who has not agreed. Minors need a parent or guardian's consent."
    },
    {
      "category": "advertising",
      "text": "Charitable solicitation registration and disclosure rules vary by state and country. Impact claims need reporting behind them."
    },
    {
      "category": "general",
      "text": "Show people with dignity, avoid pity framing, and let them decide how they are shown."
    },
    {
      "category": "music",
      "text": "Use only music you have the right to use: a licensed or CC0 library, or your own. Do not reuse a platform's in-app sound library on other platforms, and check that the licence covers paid ads if you promote the video."
    }
  ],
  "confirmations": [
    {
      "id": "release",
      "ask": "Do you have a written release from every person shown, especially minors and people in medical or refugee situations?"
    },
    {
      "id": "impact-true",
      "ask": "Can you back up the impact figure with your own reporting?"
    }
  ]
}
