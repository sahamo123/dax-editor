{
  "id": "b2b-testimonial",
  "version": 1,
  "kind": "industry",
  "name": "B2B customer testimonial",
  "description": "Customer story: name, title and company lower-third, a metric callout with a 'results vary' note, an optional disclosure line for any material connection and a case-study end card. Captions and music are listed as not available yet.",
  "tags": ["b2b", "testimonial", "case-study", "linkedin", "youtube"],
  "license": "Apache-2.0",
  "author": "dax-editor contributors",
  "source": "docs/research/industry-video-templates.md section 20 and example C",
  "variables": [
    {
      "name": "speaker_name",
      "label": "Customer name",
      "type": "name",
      "required": true,
      "maxLength": 50,
      "example": "Priya Nair"
    },
    {
      "name": "customer_title",
      "label": "Customer job title",
      "type": "text",
      "required": false,
      "maxLength": 50,
      "example": "Head of Operations"
    },
    {
      "name": "company",
      "label": "Customer company",
      "type": "text",
      "required": false,
      "maxLength": 50,
      "example": "Northwind Logistics"
    },
    {
      "name": "metric",
      "label": "Result with a number",
      "type": "text",
      "required": false,
      "maxLength": 50,
      "example": "Cut onboarding time by 40%"
    },
    {
      "name": "metric_note",
      "label": "Source and 'results vary' note",
      "type": "text",
      "required": false,
      "maxLength": 80,
      "example": "Results vary. Source: 2026 customer survey."
    },
    {
      "name": "disclosure",
      "label": "Material connection, if any",
      "type": "text",
      "required": false,
      "maxLength": 80,
      "example": "Customer received a discount for this video"
    },
    {
      "name": "cta_text",
      "label": "Call to action",
      "type": "text",
      "required": false,
      "maxLength": 40,
      "default": "Read the full case study",
      "example": "Read the full case study"
    },
    {
      "name": "url",
      "label": "Web address",
      "type": "url",
      "required": false,
      "example": "example.com/case-study"
    }
  ],
  "formats": [
    {
      "aspect": "16:9",
      "lengthSec": {
        "min": 30,
        "max": 240
      },
      "platforms": [
        {
          "platform": "youtube",
          "lengthSec": {
            "min": 120,
            "max": 240
          }
        },
        {
          "platform": "linkedin",
          "lengthSec": {
            "min": 30,
            "max": 60
          }
        },
        {
          "platform": "website",
          "lengthSec": {
            "min": 90,
            "max": 150
          }
        }
      ]
    },
    {
      "aspect": "1:1",
      "lengthSec": {
        "min": 30,
        "max": 60
      },
      "platforms": [
        {
          "platform": "linkedin",
          "lengthSec": {
            "min": 30,
            "max": 60
          }
        }
      ]
    },
    {
      "aspect": "9:16",
      "lengthSec": {
        "min": 15,
        "max": 30
      },
      "platforms": [
        {
          "platform": "instagram-reels"
        },
        {
          "platform": "youtube-shorts"
        },
        {
          "platform": "tiktok"
        }
      ]
    }
  ],
  "defaultAspect": "16:9",
  "cleanup": {
    "preset": "standard"
  },
  "beats": [
    {
      "id": "outcome",
      "name": "Outcome in their words",
      "durationSec": {
        "min": 3,
        "max": 5
      },
      "guidance": "Open on the customer's best line.",
      "overlay": "customer"
    },
    {
      "id": "challenge",
      "name": "Challenge",
      "durationSec": {
        "min": 10,
        "max": 20
      },
      "guidance": "What was hard before."
    },
    {
      "id": "use",
      "name": "What they did",
      "durationSec": {
        "min": 20,
        "max": 40
      },
      "guidance": "How they used the product."
    },
    {
      "id": "result",
      "name": "Result",
      "durationSec": {
        "min": 10,
        "max": 20
      },
      "guidance": "A number, sourced.",
      "overlay": "metric"
    },
    {
      "id": "quote",
      "name": "Recommendation",
      "durationSec": {
        "min": 3,
        "max": 5
      },
      "guidance": "A short quote."
    },
    {
      "id": "cta",
      "name": "Call to action",
      "durationSec": {
        "min": 4,
        "max": 5
      },
      "guidance": "One next step.",
      "overlay": "end-card"
    }
  ],
  "overlays": [
    {
      "id": "customer",
      "preset": "lower-third-slide",
      "text": "{{speaker_name}}",
      "subtitle": "{{customer_title}} · {{company}}",
      "when": "speaker_name",
      "anchor": "start",
      "offset": 1,
      "duration": 5,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 1
    },
    {
      "id": "metric",
      "preset": "callout-slide-up",
      "text": "{{metric}}",
      "subtitle": "{{metric_note}}",
      "when": "metric",
      "anchor": "end",
      "offset": 8,
      "duration": 4,
      "minDuration": 1.5,
      "maxFraction": 0.4,
      "priority": 1
    },
    {
      "id": "disclosure",
      "preset": "caption-bottom",
      "text": "{{disclosure}}",
      "when": "disclosure",
      "anchor": "full",
      "offset": 0,
      "minDuration": 1,
      "priority": 0
    },
    {
      "id": "end-card",
      "preset": "title-fade",
      "text": "{{cta_text}}",
      "subtitle": "{{url}}",
      "anchor": "end",
      "offset": 0,
      "duration": 4.5,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 2
    }
  ],
  "fades": {
    "in": 0.4,
    "out": 0.8
  },
  "deferred": [
    {
      "id": "captions",
      "title": "Captions",
      "description": "Captions, which LinkedIn advises for video.",
      "requires": ["captions"]
    },
    {
      "id": "music",
      "title": "Low music bed",
      "description": "A quiet bed ducked under speech.",
      "requires": ["music-bed", "audio-ducking"]
    }
  ],
  "notes": [
    {
      "category": "testimonials",
      "text": "Testimonials and reviews must come from real people who agreed to appear and reflect their real experience. If you paid them or gave them something free, say so in the video itself, not only in the caption."
    },
    {
      "category": "testimonials",
      "text": "In many places a connection between you and the person recommending you (payment, free product, partnership, employment) must be disclosed in the video itself."
    },
    {
      "category": "advertising",
      "text": "Numbers must be accurate, dated and sourced, and show 'results vary' where they are not typical."
    },
    {
      "category": "music",
      "text": "Use only music you have the right to use: a licensed or CC0 library, or your own. Do not reuse a platform's in-app sound library on other platforms, and check that the licence covers paid ads if you promote the video."
    }
  ],
  "confirmations": [
    {
      "id": "approval",
      "ask": "Did the customer approve the final cut and the use of their name and logo in writing?"
    },
    {
      "id": "connection",
      "ask": "Is there a material connection? If yes, is it disclosed in the video?"
    },
    {
      "id": "metric-sourced",
      "ask": "Is the metric accurate, dated and sourced?"
    }
  ]
}
