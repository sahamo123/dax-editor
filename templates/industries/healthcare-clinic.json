{
  "id": "healthcare-clinic",
  "version": 1,
  "kind": "industry",
  "name": "Healthcare clinic",
  "description": "Low-risk clinic video: provider introduction with credential, a standing 'general information' line, calm pacing and a booking end card. Captions and music are listed as not available yet.",
  "tags": ["healthcare", "clinic", "dental", "medical", "website"],
  "license": "Apache-2.0",
  "author": "dax-editor contributors",
  "source": "docs/research/industry-video-templates.md section 8",
  "variables": [
    {
      "name": "speaker_name",
      "label": "Provider name",
      "type": "name",
      "required": true,
      "maxLength": 50,
      "example": "Dr. Maya Singh"
    },
    {
      "name": "speaker_role",
      "label": "Credential",
      "type": "text",
      "required": false,
      "maxLength": 70,
      "example": "Family physician, MD"
    },
    {
      "name": "disclaimer",
      "label": "Disclaimer line shown at the bottom",
      "type": "text",
      "required": false,
      "maxLength": 100,
      "default": "General information only, not medical advice.",
      "example": "General information only, not medical advice."
    },
    {
      "name": "cta_text",
      "label": "Call to action",
      "type": "text",
      "required": false,
      "maxLength": 30,
      "default": "Book an appointment",
      "example": "Book an appointment"
    },
    {
      "name": "phone",
      "label": "Phone number",
      "type": "phone",
      "required": false,
      "example": "+1 555 010 0199"
    },
    {
      "name": "url",
      "label": "Web address",
      "type": "url",
      "required": false,
      "example": "example.com/book"
    }
  ],
  "formats": [
    {
      "aspect": "16:9",
      "lengthSec": {
        "min": 60,
        "max": 90
      },
      "platforms": [
        {
          "platform": "website",
          "lengthSec": {
            "min": 60,
            "max": 90
          }
        },
        {
          "platform": "youtube",
          "lengthSec": {
            "min": 60,
            "max": 120
          }
        }
      ]
    },
    {
      "aspect": "9:16",
      "lengthSec": {
        "min": 15,
        "max": 30
      },
      "platforms": [
        {
          "platform": "instagram-reels"
        },
        {
          "platform": "tiktok"
        },
        {
          "platform": "youtube-shorts"
        }
      ]
    }
  ],
  "defaultAspect": "16:9",
  "cleanup": {
    "preset": "gentle"
  },
  "beats": [
    {
      "id": "intro",
      "name": "Provider introduction",
      "durationSec": {
        "min": 0,
        "max": 5
      },
      "guidance": "Name and credential on screen.",
      "overlay": "speaker"
    },
    {
      "id": "treats",
      "name": "What the clinic treats",
      "durationSec": {
        "min": 5,
        "max": 15
      },
      "guidance": "Plain words, no urgency."
    },
    {
      "id": "visit",
      "name": "What a visit looks like",
      "durationSec": {
        "min": 15,
        "max": 30
      },
      "guidance": "Office tour with no patients on camera."
    },
    {
      "id": "book",
      "name": "How to book",
      "durationSec": {
        "min": 5,
        "max": 5
      },
      "guidance": "Phone or web address."
    },
    {
      "id": "end",
      "name": "End card",
      "durationSec": {
        "min": 5,
        "max": 5
      },
      "guidance": "Booking route.",
      "overlay": "end-card"
    }
  ],
  "overlays": [
    {
      "id": "speaker",
      "preset": "lower-third-slide",
      "text": "{{speaker_name}}",
      "subtitle": "{{speaker_role}}",
      "when": "speaker_name",
      "anchor": "start",
      "offset": 1,
      "duration": 5,
      "minDuration": 2.5,
      "maxFraction": 0.5,
      "priority": 1
    },
    {
      "id": "disclosure",
      "preset": "caption-bottom",
      "text": "{{disclaimer}}",
      "when": "disclaimer",
      "anchor": "full",
      "offset": 0,
      "minDuration": 1,
      "priority": 0
    },
    {
      "id": "end-card",
      "preset": "title-fade",
      "text": "{{cta_text}}",
      "subtitle": "{{phone}} · {{url}}",
      "anchor": "end",
      "offset": 0,
      "duration": 5,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 2
    }
  ],
  "fades": {
    "in": 0.5,
    "out": 1
  },
  "deferred": [
    {
      "id": "captions",
      "title": "Captions",
      "description": "Captions for accessibility and sound-off viewing.",
      "requires": ["captions"]
    },
    {
      "id": "music",
      "title": "Calm low music",
      "description": "A quiet bed with no urgency.",
      "requires": ["music-bed", "audio-ducking"]
    }
  ],
  "notes": [
    {
      "category": "health",
      "text": "Showing a patient's identity or story in marketing generally needs the patient's written authorization, not only a general media release. Staff intros and office tours are the lowest-risk content."
    },
    {
      "category": "health",
      "text": "Medical and dental boards have rules on testimonials, before-and-after images and claims such as 'painless' or 'guaranteed'. Check yours."
    },
    {
      "category": "testimonials",
      "text": "Testimonials and reviews must come from real people who agreed to appear and reflect their real experience. If you paid them or gave them something free, say so in the video itself, not only in the caption."
    },
    {
      "category": "ai-disclosure",
      "text": "If any shot is AI-generated or altered to look real, check whether the platform requires a disclosure label."
    },
    {
      "category": "music",
      "text": "Use only music you have the right to use: a licensed or CC0 library, or your own. Do not reuse a platform's in-app sound library on other platforms, and check that the licence covers paid ads if you promote the video."
    }
  ],
  "confirmations": [
    {
      "id": "patients",
      "ask": "Is every patient shown, or their story told, covered by written authorization?"
    },
    {
      "id": "claims",
      "ask": "Does the video avoid 'guaranteed', 'painless' and clinical before-and-after claims?"
    }
  ]
}
