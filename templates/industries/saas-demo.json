{
  "id": "saas-demo",
  "version": 1,
  "kind": "industry",
  "name": "Software demo",
  "description": "Show one workflow that ends in a visible result: outcome title, presenter lower-third, trimmed load times and a free-trial end card. Music (when you supply it) is added. UI zoom, captions and speed-ups are listed as not available yet.",
  "tags": ["software", "saas", "demo", "b2b", "linkedin", "youtube"],
  "license": "Apache-2.0",
  "author": "dax-editor contributors",
  "source": "docs/research/industry-video-templates.md section 2",
  "variables": [
    {
      "name": "title",
      "label": "Outcome",
      "type": "text",
      "required": false,
      "maxLength": 60,
      "example": "Send invoices in 30 seconds"
    },
    {
      "name": "speaker_name",
      "label": "Speaker name",
      "type": "name",
      "required": false,
      "maxLength": 50,
      "example": "Alex Rivera"
    },
    {
      "name": "speaker_role",
      "label": "Speaker role or company",
      "type": "text",
      "required": false,
      "maxLength": 70,
      "example": "Founder, Rivera Studio"
    },
    {
      "name": "cta_text",
      "label": "Call to action",
      "type": "text",
      "required": false,
      "maxLength": 40,
      "default": "Start your free trial",
      "example": "Start your free trial"
    },
    {
      "name": "url",
      "label": "Web address",
      "type": "url",
      "required": false,
      "example": "example.com/book"
    }
  ],
  "formats": [
    {
      "aspect": "16:9",
      "lengthSec": {
        "min": 60,
        "max": 180
      },
      "platforms": [
        {
          "platform": "youtube",
          "lengthSec": {
            "min": 120,
            "max": 180
          }
        },
        {
          "platform": "website",
          "lengthSec": {
            "min": 60,
            "max": 120
          }
        }
      ]
    },
    {
      "aspect": "4:5",
      "lengthSec": {
        "min": 30,
        "max": 60
      },
      "platforms": [
        {
          "platform": "linkedin",
          "lengthSec": {
            "min": 30,
            "max": 60
          }
        }
      ]
    },
    {
      "aspect": "9:16",
      "lengthSec": {
        "min": 15,
        "max": 30
      },
      "platforms": [
        {
          "platform": "instagram-reels"
        },
        {
          "platform": "youtube-shorts"
        },
        {
          "platform": "tiktok"
        }
      ]
    }
  ],
  "defaultAspect": "16:9",
  "cleanup": {
    "preset": "tutorial"
  },
  "beats": [
    {
      "id": "outcome",
      "name": "Outcome hook",
      "durationSec": {
        "min": 0,
        "max": 3
      },
      "guidance": "Show the finished result first.",
      "overlay": "title"
    },
    {
      "id": "problem",
      "name": "Problem",
      "durationSec": {
        "min": 3,
        "max": 10
      },
      "guidance": "The pain in one sentence."
    },
    {
      "id": "workflow",
      "name": "One workflow",
      "durationSec": {
        "min": 15,
        "max": 60
      },
      "guidance": "One workflow only; keep 0.5 s on each UI change so the eye can follow."
    },
    {
      "id": "proof",
      "name": "Proof",
      "durationSec": {
        "min": 5,
        "max": 10
      },
      "guidance": "A number, a customer line or a result screen."
    },
    {
      "id": "cta",
      "name": "Call to action",
      "durationSec": {
        "min": 3,
        "max": 5
      },
      "guidance": "One next step.",
      "overlay": "end-card"
    }
  ],
  "overlays": [
    {
      "id": "title",
      "preset": "title-fade",
      "text": "{{title}}",
      "when": "title",
      "anchor": "start",
      "offset": 0.3,
      "duration": 3,
      "minDuration": 1.5,
      "maxFraction": 0.45,
      "priority": 1
    },
    {
      "id": "speaker",
      "preset": "lower-third-slide",
      "text": "{{speaker_name}}",
      "subtitle": "{{speaker_role}}",
      "when": "speaker_name",
      "anchor": "start",
      "offset": 3.5,
      "duration": 4,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 1
    },
    {
      "id": "end-card",
      "preset": "title-fade",
      "text": "{{cta_text}}",
      "subtitle": "{{url}}",
      "anchor": "end",
      "offset": 0,
      "duration": 5,
      "minDuration": 2,
      "maxFraction": 0.5,
      "priority": 2
    }
  ],
  "fades": {
    "in": 0.3,
    "out": 0.5
  },
  "effects": [
    {
      "id": "music",
      "kind": "music",
      "title": "Light music",
      "description": "A quiet bed, lowered while someone speaks.",
      "level": 0.12
    }
  ],
  "deferred": [
    {
      "id": "ui-zoom",
      "title": "Zoom on the UI and cursor highlight",
      "description": "Zoom to the part of the screen being used. Zoom moves exist, but the editor has no cursor or click track yet.",
      "requires": ["cursor-zoom"]
    },
    {
      "id": "captions",
      "title": "Captions",
      "description": "On-screen text at no more than 5 to 10 words per second.",
      "requires": ["captions"]
    },
    {
      "id": "load-times",
      "title": "Trim load times",
      "description": "Speed up or cut waiting.",
      "requires": ["speed-change"]
    }
  ],
  "notes": [
    {
      "category": "advertising",
      "text": "Speed or benchmark claims need a source shown on screen or in the description."
    },
    {
      "category": "testimonials",
      "text": "Customer logos and quotes need written permission."
    },
    {
      "category": "privacy",
      "text": "Hide other users' data, emails and keys in the recording."
    },
    {
      "category": "music",
      "text": "Use only music you have the right to use: a licensed or CC0 library, or your own. Do not reuse a platform's in-app sound library on other platforms, and check that the licence covers paid ads if you promote the video."
    }
  ],
  "confirmations": [
    {
      "id": "data-hidden",
      "ask": "Is any customer data, private email or secret key visible in the recording?"
    }
  ]
}
